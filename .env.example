# Supabase Postgres — transaction-mode pooler (runtime, IPv4)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase Postgres — session-mode pooler (migrations)
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres"

# Email (Resend — https://resend.com). Leave blank to log emails to console in dev.
RESEND_API_KEY=""
EMAIL_FROM="The Bell Frog Inn <bookings@thebellfrog.com>"

# Initial admin account (used by `pnpm db:seed`; change afterwards in /admin)
ADMIN_EMAIL="bookings@thebellfrog.com"
ADMIN_PASSWORD="change-me"

# Secret required to hit /api/ical/sync (cron-job.org, Vercel Cron, etc.)
ICAL_SYNC_SECRET="change-me-too"

# Supabase Storage (image uploads) — service-role key from Supabase Dashboard → Settings → API
SUPABASE_URL="https://pnlndxhbjmcinxthvwhi.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

